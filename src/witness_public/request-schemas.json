  "tool_register_project": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "maxLength": 128
      },
      "domains": {
        "type": "string",
        "maxLength": 2000,
        "encoding": "csv_or_json_array_v1"
      },
      "description": {
        "type": "string",
        "maxLength": 4000
      },
      "caller_instance_id": {
        "type": "string",
        "maxLength": 128
      },
      "request_id": {
        "type": "string",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "normalization": "none; exact ASCII bytes are the idempotency identity"
      },
      "identity_envelope": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "const": "1.0"
          },
          "principal_pubkey": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "owner_pubkey": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "owner_attestation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "conditions": {
                "type": "string",
                "maxLength": 2000
              },
              "signature": {
                "type": "string",
                "pattern": "^[0-9a-f]{128}$"
              }
            },
            "required": [
              "conditions",
              "signature"
            ]
          },
          "profile_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "profile_version_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "tenant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "runtime_generation": {
            "type": "string",
            "format": "uuid"
          },
          "tool_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "nonce": {
            "type": "string",
            "format": "uuid"
          },
          "issued_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 253402300799
          },
          "expires_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 253402300799
          },
          "signature": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          }
        },
        "required": [
          "version",
          "principal_pubkey",
          "owner_pubkey",
          "owner_attestation",
          "profile_id",
          "profile_version_sha256",
          "tenant_id",
          "runtime_generation",
          "tool_name",
          "payload_sha256",
          "nonce",
          "issued_at",
          "expires_at",
          "signature"
        ],
        "constraints": [
          "expires_at > issued_at",
          "tenant_id equals server-resolved tenant",
          "tool_name equals dispatch target",
          "payload_sha256 binds exact raw request without identity_envelope",
          "principal_pubkey verifies signature",
          "owner_pubkey verifies owner_attestation",
          "profile hash resolves current authorized bytes",
          "nonce atomically first-use in shared tenant store"
        ]
      }
    },
    "required": [
      "name",
      "domains",
      "caller_instance_id",
      "request_id",
      "identity_envelope"
    ]
  },
